{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lodado/shareds/ux-flow-diagram/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "figma": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://(?:www\\.)?figma\\.com/(?:design|file)/[A-Za-z0-9._~-]+(?:[/?#].*)?$"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "nodeId": {
          "type": "string"
        },
        "route": {
          "type": "string"
        }
      }
    },
    "source": {
      "enum": ["figma", "codebase", "requirements", "ir"]
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["auto", "exact", "hybrid", "inferred"]
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "markdown": {
          "type": "boolean"
        },
        "mermaid": {
          "type": "boolean"
        },
        "json": {
          "type": "boolean"
        },
        "critique": {
          "type": "boolean"
        },
        "proposedFlow": {
          "type": "boolean"
        },
        "figjam": {
          "type": "boolean"
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "includeComponentInteractions": {
          "type": "boolean"
        },
        "includeExternalLinks": {
          "type": "boolean"
        },
        "screenshots": {
          "enum": ["auto", "always", "never"]
        }
      }
    }
  },
  "anyOf": [
    {
      "required": ["figma"]
    },
    {
      "required": ["source"]
    }
  ],
  "allOf": [
    {
      "if": {
        "required": ["source"],
        "properties": {
          "source": {
            "const": "figma"
          }
        }
      },
      "then": {
        "required": ["figma"]
      }
    },
    {
      "if": {
        "required": ["figma"]
      },
      "then": {
        "properties": {
          "source": {
            "const": "figma"
          }
        }
      }
    }
  ]
}
