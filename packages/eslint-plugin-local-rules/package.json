{
  "name": "@lodado/eslint-plugin-local-rules",
  "version": "0.1.0",
  "description": "Custom ESLint rules shared across lodado projects",
  "license": "MIT",
  "type": "commonjs",
  "main": "index.js",
  "files": [
    "README.md",
    "index.js",
    "rules",
    "contracts",
    "examples"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lodado/my-Vibe-Coding-Helper.git",
    "directory": "packages/eslint-plugin-local-rules"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test.js && node examples.test.js && tsc -p examples/tsconfig.json && pnpm test:strict",
    "lint": "eslint index.js rules test.js examples.test.js strict-ui.test.js fsd-strict.test.js",
    "test:strict": "node strict-ui.test.js && node fsd-strict.test.js"
  },
  "peerDependencies": {
    "eslint": "^8.57.0 || ^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10",
    "@types/react": "19",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.12.0"
  },
  "dependencies": {
    "typescript": "5.9.3"
  }
}
