{
  "name": "@lodado/eslint-config",
  "version": "1.0.0",
  "description": "Composable ESLint presets - enable only the ones you want",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lodado/my-Vibe-Coding-Helper.git",
    "directory": "packages/eslint-config"
  },
  "exports": {
    ".": "./index.mjs",
    "./react": "./react.mjs",
    "./next": "./next.js",
    "./a11y": "./a11y.js",
    "./turbo": "./turbo.js",
    "./local-rules": "./local-rules.js",
    "./testing": "./testing.js",
    "./query": "./query.js",
    "./quality": "./quality.js",
    "./fsd": "./fsd.js",
    "./strict-types": "./strict-types.js",
    "./interaction": "./interaction.js",
    "./functional": "./functional.mjs",
    "./tailwind": "./tailwind.js",
    "./ai": "./ai.js",
    "./design": "./design.mjs"
  },
  "main": "index.mjs",
  "files": [
    "QUALITY.md",
    "a11y.js",
    "ai.js",
    "design.mjs",
    "fsd.js",
    "functional.mjs",
    "index.mjs",
    "interaction.js",
    "local-rules.js",
    "next.js",
    "quality.js",
    "query.js",
    "react.mjs",
    "strict-types.js",
    "tailwind.js",
    "testing.js",
    "turbo.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "test": "node test.js && node --test feedback.test.mjs functional.test.mjs",
    "lint": "eslint index.mjs ai.js design.mjs react.mjs next.js a11y.js turbo.js local-rules.js testing.js query.js quality.js fsd.js interaction.js test.js strict-types.js tailwind.js functional.mjs feedback.test.mjs functional.test.mjs package.json"
  },
  "peerDependencies": {
    "@deslint/eslint-plugin": "^0.10.0",
    "eslint": "^10.0.0",
    "eslint-plugin-ai-guard": "^1.3.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "tailwindcss": "^4.1.17"
  },
  "peerDependenciesMeta": {
    "@deslint/eslint-plugin": {
      "optional": true
    },
    "eslint-plugin-ai-guard": {
      "optional": true
    },
    "eslint-plugin-better-tailwindcss": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@eslint-react/eslint-plugin": "^5.20.3",
    "@lodado/eslint-plugin-local-rules": "workspace:*",
    "@next/eslint-plugin-next": "^16.3.5",
    "@tanstack/eslint-plugin-query": "^5.103.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-turbo": "^2.11.2",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "typescript-eslint": "^8.70.0"
  },
  "devDependencies": {
    "@deslint/eslint-plugin": "^0.10.0",
    "eslint": "^10.11.0",
    "eslint-plugin-ai-guard": "^1.3.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "tailwindcss": "^4.1.17"
  }
}
