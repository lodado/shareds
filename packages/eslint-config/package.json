{
  "name": "@lodado/eslint-config",
  "version": "1.0.0",
  "description": "Composable ESLint presets - enable only the ones you want",
  "license": "MIT",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./react": "./react.js",
    "./next": "./next.js",
    "./a11y": "./a11y.js",
    "./turbo": "./turbo.js",
    "./local-rules": "./local-rules.js",
    "./testing": "./testing.js",
    "./query": "./query.js",
    "./quality": "./quality.js",
    "./fsd": "./fsd.js",
    "./strict-types": "./strict-types.js"
  },
  "files": [
    "index.mjs",
    "react.js",
    "next.js",
    "a11y.js",
    "turbo.js",
    "local-rules.js",
    "testing.js",
    "query.js",
    "quality.js",
    "QUALITY.md",
    "fsd.js",
    "strict-types.js"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lodado/my-Vibe-Coding-Helper.git",
    "directory": "packages/eslint-config"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test.js",
    "lint": "eslint index.mjs react.js next.js a11y.js turbo.js local-rules.js testing.js query.js quality.js fsd.js test.js strict-types.js"
  },
  "dependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@lodado/eslint-plugin-local-rules": "workspace:*",
    "@tanstack/eslint-plugin-query": "^5.102.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint-config-next": "^16.3.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-turbo": "^2.10.11",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "typescript-eslint": "^8.67.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "next": "^16.3.2"
  }
}
