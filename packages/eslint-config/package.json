{
  "name": "@lodado/eslint-config",
  "version": "0.0.0",
  "description": "Composable ESLint presets - enable only the ones you want",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./react": "./react.js",
    "./next": "./next.js",
    "./a11y": "./a11y.js",
    "./turbo": "./turbo.js",
    "./local-rules": "./local-rules.js",
    "./testing": "./testing.js",
    "./query": "./query.js",
    "./fsd": "./fsd.js",
    "./strict-types": "./strict-types.js"
  },
  "files": [
    "index.js",
    "react.js",
    "next.js",
    "a11y.js",
    "turbo.js",
    "local-rules.js",
    "testing.js",
    "query.js",
    "fsd.js",
    "strict-types.js"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lodado/my-Vibe-Coding-Helper.git",
    "directory": "packages/eslint-config"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test.js",
    "lint": "eslint index.js react.js next.js a11y.js turbo.js local-rules.js testing.js query.js fsd.js test.js strict-types.js"
  },
  "dependencies": {
    "@lodado/eslint-plugin-local-rules": "workspace:*",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-next": "^14.2.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-turbo": "^1.13.4",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-vitest": "^0.5.4"
  },
  "peerDependencies": {
    "eslint": "^8.57.0"
  }
}
