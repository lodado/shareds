{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "mode": {
      "type": "string",
      "enum": ["PLAN_ONLY", "FIGMA"]
    },
    "concept": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "experience_promise": {
          "type": "string",
          "minLength": 1
        },
        "core_decision": {
          "type": "string",
          "minLength": 1
        },
        "first_meaningful_action": {
          "type": "string",
          "minLength": 1
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": ["title", "experience_promise", "core_decision", "first_meaningful_action", "out_of_scope"],
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "properties": {
        "planning": {
          "type": "string",
          "enum": ["DRAFT", "PLAN_READY", "INCOMPLETE", "BLOCKED"]
        },
        "figma": {
          "type": "string",
          "enum": ["not_requested", "PILOT_READY", "FIGMA_READY", "INCOMPLETE", "BLOCKED", "NEEDS_INPUT"]
        },
        "playable": {
          "type": "string",
          "enum": ["not_requested", "not_run", "planned", "tested"]
        },
        "usability": {
          "type": "string",
          "enum": ["not_run", "planned", "observed"]
        },
        "fun": {
          "type": "string",
          "enum": ["not_run", "planned", "observed"]
        },
        "business": {
          "type": "string",
          "enum": ["not_run", "planned", "observed"]
        },
        "user_acceptance": {
          "type": "string",
          "enum": ["not_obtained", "accepted", "rejected"]
        }
      },
      "required": ["planning", "figma", "playable", "usability", "fun", "business", "user_acceptance"],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[a-zA-Z0-9_-]+$"
          },
          "kind": {
            "type": "string",
            "enum": ["game_design", "ux_flow", "visual_feel", "validation_handoff", "reference_log"]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["draft", "complete", "stale"]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*-[a-zA-Z0-9_-]+$"
            },
            "minItems": 0
          }
        },
        "required": ["id", "kind", "path", "status", "evidence_ids"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[a-zA-Z0-9_-]+$"
          },
          "invariant": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "invariant", "verification"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "state_machines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[a-zA-Z0-9_-]+$"
          },
          "initial_state": {
            "type": "string",
            "minLength": 1
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9]*-[a-zA-Z0-9_-]+$"
                },
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "type": "string",
                  "minLength": 1
                },
                "event": {
                  "type": "string",
                  "minLength": 1
                },
                "guard": {
                  "type": "string",
                  "minLength": 1
                },
                "effects": {
                  "type": "string",
                  "minLength": 1
                },
                "recovery": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["id", "from", "to", "event", "guard", "effects", "recovery"],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": ["id", "initial_state", "states", "transitions"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[a-zA-Z0-9_-]+$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "primary_actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9]*-[a-zA-Z0-9_-]+$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "transition_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9]*-[a-zA-Z0-9_-]+$"
                  },
                  "minItems": 1
                }
              },
              "required": ["id", "label", "transition_ids"],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": ["id", "purpose", "primary_actions"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "feedback": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[a-zA-Z0-9_-]+$"
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "first_response": {
            "type": "string",
            "minLength": 1
          },
          "rule_result": {
            "type": "string",
            "minLength": 1
          },
          "visual": {
            "type": "string",
            "minLength": 1
          },
          "audio": {
            "type": "string",
            "minLength": 1
          },
          "interruptions": {
            "type": "string",
            "minLength": 1
          },
          "reduced_effects": {
            "type": "string",
            "minLength": 1
          },
          "tuning_basis": {
            "type": "string",
            "enum": ["proposal", "measured"]
          }
        },
        "required": [
          "id",
          "action",
          "first_response",
          "rule_result",
          "visual",
          "audio",
          "interruptions",
          "reduced_effects",
          "tuning_basis"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[a-zA-Z0-9_-]+$"
          },
          "hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "measure": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["planned", "not_run", "observed"]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*-[a-zA-Z0-9_-]+$"
            },
            "minItems": 0
          }
        },
        "required": ["id", "hypothesis", "method", "measure", "status", "evidence_ids"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "journey_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[a-zA-Z0-9_-]+$"
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*-[a-zA-Z0-9_-]+$"
            },
            "minItems": 1
          },
          "screen_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*-[a-zA-Z0-9_-]+$"
            },
            "minItems": 1
          },
          "transition_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*-[a-zA-Z0-9_-]+$"
            },
            "minItems": 1
          },
          "feedback_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*-[a-zA-Z0-9_-]+$"
            },
            "minItems": 1
          },
          "experiment_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*-[a-zA-Z0-9_-]+$"
            },
            "minItems": 1
          }
        },
        "required": ["journey_id", "rule_ids", "screen_ids", "transition_ids", "feedback_ids", "experiment_ids"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "interruption_policy": {
      "type": "object",
      "properties": {
        "independent_pause_reasons": {
          "type": "boolean"
        },
        "resume_condition": {
          "type": "string",
          "minLength": 1
        },
        "ads_enabled": {
          "type": "boolean"
        },
        "resume_when_hidden": {
          "type": "boolean"
        },
        "reward_idempotency_key": {
          "type": ["string", "null"]
        },
        "decline_path": {
          "type": ["string", "null"]
        },
        "provider_policy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "independent_pause_reasons",
        "resume_condition",
        "ads_enabled",
        "resume_when_hidden",
        "reward_idempotency_key",
        "decline_path",
        "provider_policy"
      ],
      "additionalProperties": false
    },
    "figma": {
      "type": "object",
      "properties": {
        "interaction_required": {
          "type": "boolean"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file_url": {
                "type": "string",
                "pattern": "^https://(www\\.)?figma\\.com/[^ ]+"
              },
              "page_id": {
                "type": "string",
                "minLength": 1
              },
              "frame_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["file_url", "page_id", "frame_id"],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "checks": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": ["verified", "not_run", "not_required"]
            },
            "structure": {
              "type": "string",
              "enum": ["verified", "not_run", "not_required"]
            },
            "visual": {
              "type": "string",
              "enum": ["verified", "not_run", "not_required"]
            },
            "prototype": {
              "type": "string",
              "enum": ["verified", "not_run", "not_required"]
            }
          },
          "required": ["source", "structure", "visual", "prototype"],
          "additionalProperties": false
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[a-zA-Z0-9_-]+$"
          },
          "minItems": 0
        },
        "unverified": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": ["interaction_required", "artifacts", "checks", "evidence_ids", "unverified"],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[a-zA-Z0-9_-]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "design_document",
              "source_read",
              "static_check",
              "figma_structure",
              "figma_visual",
              "figma_prototype",
              "playable_test",
              "usability_session",
              "fun_session",
              "business_observation",
              "user_response"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "kind", "locator", "description"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[a-zA-Z0-9_-]+$"
          },
          "scope": {
            "type": "string",
            "enum": ["planning", "figma", "playable", "usability", "fun", "business", "rights"]
          },
          "severity": {
            "type": "string",
            "enum": ["blocking", "nonblocking"]
          },
          "status": {
            "type": "string",
            "enum": ["open", "resolved"]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "scope", "severity", "status", "description"],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "mode",
    "concept",
    "readiness",
    "artifacts",
    "rules",
    "state_machines",
    "screens",
    "feedback",
    "experiments",
    "trace",
    "interruption_policy",
    "figma",
    "evidence",
    "issues"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game design delivery manifest",
  "description": "This schema and semantic validator check declarations, not actual tool execution, fun or business outcomes."
}
