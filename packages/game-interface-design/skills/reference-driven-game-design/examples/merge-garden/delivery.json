  "rules": [
    {
      "id": "R-drop",
      "invariant": "gesture당 유효 release 투하 1회",
      "verification": "중복 release와 pointercancel 테스트"
    },
    {
      "id": "R-merge",
      "invariant": "한 tick에서 entity가 최대 한 pair에 소모",
      "verification": "같은 객체의 중복 pair 테스트"
    },
    {
      "id": "R-score",
      "invariant": "merge event ID당 점수 1회",
      "verification": "사건과 효과 재생 중복 테스트"
    },
    {
      "id": "R-end",
      "invariant": "grace 이후 연속 overflow의 게임 시간만 누적",
      "verification": "pause/짧은 통과 비교"
    },
    {
      "id": "R-reset",
      "invariant": "이전 run 사건이 새 판을 변경하지 않음",
      "verification": "late event 테스트"
    }
  ],
  "state_machines": [
    {
      "id": "M-run",
      "initial_state": "ready",
      "states": ["ready", "playing", "result"],
      "transitions": [
        {
          "id": "T-start",
          "from": "ready",
          "to": "playing",
          "event": "start",
          "guard": "assets ready; no active run",
          "effects": "reset run",
          "recovery": "loading failure: retry"
        },
        {
          "id": "T-drop",
          "from": "playing",
          "to": "playing",
          "event": "release",
          "guard": "canAdvance and valid gesture and cooldown elapsed",
          "effects": "commit one object",
          "recovery": "pointercancel: no object"
        },
        {
          "id": "T-merge",
          "from": "playing",
          "to": "playing",
          "event": "eligible pair",
          "guard": "both unconsumed; same tier < 4",
          "effects": "consume pair; score once",
          "recovery": "duplicate: ignore"
        },
        {
          "id": "T-fail",
          "from": "playing",
          "to": "result",
          "event": "overflow committed",
          "guard": "grace and continuous duration met",
          "effects": "end run once",
          "recovery": "repeat event: ignore"
        },
        {
          "id": "T-replay",
          "from": "result",
          "to": "playing",
          "event": "replay",
          "guard": "no active replay transaction",
          "effects": "new run; cancel old work",
          "recovery": "duplicate button: one run"
        }
      ]
    }
  ],
  "screens": [
    {
      "id": "S-ready",
      "purpose": "설정 없이 시작",
      "primary_actions": [
