{
  "name": "@lodado/frontend-oracle-design-plugin",
  "version": "0.83.0",
  "private": true,
  "description": "Claude Code / Codex plugin for medium/high-risk Oracle-driven frontend delivery.",
  "license": "MIT",
  "scripts": {
    "lint": "eslint skills scripts --ignore-pattern 'skills/frontend-oracle-design/bundles/**' && node skills/frontend-oracle-design/scripts/generate-reference-bundles.mjs --check && node skills/frontend-oracle-design/evals/to-skill-creator-evals.mjs --check",
    "test": "node --test scripts/*.test.mjs skills/frontend-oracle-design/scripts/*.test.mjs",
    "workflow-docs:generate": "node skills/frontend-oracle-design/scripts/generate-workflow-docs.mjs",
    "workflow-docs:check": "node skills/frontend-oracle-design/scripts/generate-workflow-docs.mjs --check",
    "bundles:generate": "node skills/frontend-oracle-design/scripts/generate-reference-bundles.mjs",
    "bundles:check": "node skills/frontend-oracle-design/scripts/generate-reference-bundles.mjs --check"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "typescript": "5.9.3"
  }
}
