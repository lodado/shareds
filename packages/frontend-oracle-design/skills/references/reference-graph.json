    {
      "id": "visual-design",
      "path": "references/visual-design.md",
      "when": "보이는 UI 변경 전; Design Intent 있으면 리뷰 재독",
      "requires": ["common"]
    },
    {
      "id": "delivery-ledger",
      "path": "references/delivery/ledger.md",
      "when": "Delivery 진입 직후 ($test 명시 호출 뒤)",
      "requires": ["common"]
