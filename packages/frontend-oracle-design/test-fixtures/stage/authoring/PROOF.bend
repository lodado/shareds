import Base
import ./MODEL.bend as M
import ./LAWS.bend as Laws

# The cell laws are generated by `oracle-model.mjs prove`; the witnesses name their traces here.

def Laws.ready_reachable():
  ([M.Begin{}, M.Walk{False{}}, M.Lock{}], {==})

def Laws.exhausted_reachable():
  ([M.Review{True{}, True{}}, M.Review{True{}, True{}}], {==})

def Laws.limit_five_reachable():
  ([M.Begin{}, M.Delegate{M.Up5{}}], {==})

def Laws.approval_reopens():
  {==}

def Laws.rewind_cap_reachable():
  ([M.Begin{}, M.Walk{False{}}, M.Rewind{M.ToDiscovering{}, True{}}, M.Walk{False{}}], {==})

def Laws.ceiling_reachable():
  ([M.Begin{}, M.Delegate{M.Up5{}}], {==})

def Laws.approval_rewinds_again():
  {==}

def Laws.rewind_cycle_spends():
  {==}
