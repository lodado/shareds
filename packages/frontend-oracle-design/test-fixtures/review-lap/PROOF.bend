import Base
import ./MODEL.bend as M
import ./LAWS.bend as Laws

# The cell laws are generated by `oracle-model.mjs prove`; the witnesses name their traces here.

def Laws.verified_with_proposal():
  ([M.Packet{}, M.Attest{M.Claim{M.Plain{}}}, M.Edit{}, M.Exec{}, M.Packet{}, M.Attest{M.Claim{M.Regression{False{}}}}, M.Review{M.ToVerified{}}], {==})

def Laws.partial_after_round_two():
  ([M.Exec{}, M.Packet{}, M.Attest{M.Claim{M.Plain{}}}, M.Edit{}, M.Exec{}, M.Packet{}, M.Attest{M.Claim{M.Previous{}}}, M.Edit{}, M.Exec{}, M.Review{M.ToPartial{}}], {==})

def Laws.third_round_refused():
  ([M.Packet{}, M.Attest{M.Clear{}}, M.Edit{}, M.Packet{}, M.Edit{}], {==})
