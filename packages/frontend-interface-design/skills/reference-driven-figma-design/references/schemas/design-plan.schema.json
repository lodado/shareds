{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lodado/shareds/reference-driven-figma-design/design-plan.schema.json",
  "title": "Bend-generated composition (not Figma delivery evidence)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "viewport", "state", "axes", "root"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "$ref": "#/$defs/pixels" },
        "height": { "$ref": "#/$defs/pixels" }
      }
    },
    "state": { "$ref": "#/$defs/name" },
    "axes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value", "scope"],
        "properties": {
          "id": { "$ref": "#/$defs/name" },
          "value": { "$ref": "#/$defs/name" },
          "scope": { "$ref": "#/$defs/name" }
        }
      }
    },
    "root": { "$ref": "#/$defs/node" }
  },
  "$defs": {
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "pixels": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "references": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/name" }
    },
    "node": {
      "oneOf": [{ "$ref": "#/$defs/stack" }, { "$ref": "#/$defs/asset" }]
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "role",
        "width",
        "direction",
        "gap",
        "padding",
        "surface",
        "children",
        "axes",
        "rules"
      ],
      "properties": {
        "kind": { "const": "stack" },
        "id": { "$ref": "#/$defs/name" },
        "role": { "$ref": "#/$defs/name" },
        "width": { "$ref": "#/$defs/pixels" },
        "direction": { "enum": ["horizontal", "vertical"] },
        "gap": { "$ref": "#/$defs/name" },
        "padding": { "$ref": "#/$defs/name" },
        "surface": { "$ref": "#/$defs/name" },
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/node" }
        },
        "axes": { "$ref": "#/$defs/references" },
        "rules": { "$ref": "#/$defs/references" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "role", "width", "source", "bindings", "axes", "rules"],
      "properties": {
        "kind": { "const": "asset" },
        "id": { "$ref": "#/$defs/name" },
        "role": { "$ref": "#/$defs/name" },
        "width": { "$ref": "#/$defs/pixels" },
        "source": { "$ref": "#/$defs/name" },
        "bindings": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["property", "content"],
            "properties": {
              "property": { "$ref": "#/$defs/name" },
              "content": { "$ref": "#/$defs/name" }
            }
          }
        },
        "axes": { "$ref": "#/$defs/references" },
        "rules": { "$ref": "#/$defs/references" }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assets", "tokens", "content"],
      "properties": {
        "assets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["locator", "properties"],
            "properties": {
              "locator": { "$ref": "#/$defs/name" },
              "properties": { "$ref": "#/$defs/references" }
            }
          }
        },
        "tokens": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "value", "locator"],
                "properties": {
                  "kind": { "const": "spacing" },
                  "value": { "type": "integer", "minimum": 0, "maximum": 10000 },
                  "locator": { "$ref": "#/$defs/name" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "value", "locator"],
                "properties": {
                  "kind": { "const": "color" },
                  "value": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
                  "locator": { "$ref": "#/$defs/name" }
                }
              }
            ]
          }
        },
        "content": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 100000 }
        }
      }
    }
  }
}
