# Tokens are read from the macOS keychain (service names below); only non-secret settings go in .env.
# `pnpm start` loads this file when it exists. Add a token with:
#   security add-generic-password -U -a "$USER" -s slack-dispatch-xapp -w
# (-w last and without a value makes security prompt, so the token stays out of shell history and ps)
KEYCHAIN_SERVICE_APP=slack-dispatch-xapp
KEYCHAIN_SERVICE_USER=slack-dispatch-xoxp
KEYCHAIN_SERVICE_BOT=slack-dispatch-xoxb
# Slack user id allowed to command the bot (every other sender is dropped)
OWNER_SLACK_USER_ID=
# Where the bot keeps its state, its lock file and the private routes file (default: ~/.slack-dispatch)
STATE_DIR=
# Seconds between two searches for new mentions (at least 10; default 300)
POLL_INTERVAL_SECONDS=300
# How many days before today a mention may be and still be picked up (0 = today only)
INGEST_DAYS=0
# 1 = push finished work and open a pull request; anything else keeps it as a local commit in the worktree
ENABLE_PR=
# Port of the read-only status address on this machine (default 9814; 0 turns it off)
STATUS_PORT=9814
# Jira Cloud (optional). With all three set, open issues assigned to you that changed today (or within INGEST_DAYS)
# are listed in the same Slack digest as mentions, with the same analysis, plan and approve buttons.
# Token: security add-generic-password -U -a "$USER" -s slack-dispatch-jira -w   (or JIRA_API_TOKEN in the env)
# Map a project to repos in routes.json: { "jiraProjects": { "PROJ": ["web-app"] } }
JIRA_BASE_URL=
JIRA_EMAIL=
# How often Jira is asked for new issues, in seconds (min 30, default 300). A new issue sends its digest right away.
JIRA_POLL_INTERVAL_SECONDS=
KEYCHAIN_SERVICE_JIRA=slack-dispatch-jira
# Extra JQL joined with AND, such as: project = PROJ
JIRA_JQL=
# 1 = the plan and the build run with your own claude setup (skills, CLAUDE.md, plugins, hooks, MCP). Default is without:
# your own settings are then ignored (`claude --restricted`). With them a rule such as `allow: ["Bash"]` lets the agent run
# any command, including git push and gh, whatever tool list this service passes.
OWN_SETUP=
